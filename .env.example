# ==========================================
# HackQubit 2.0 - Problem 18 Environment Variables
# ==========================================

# --- General Environment ---
ENV=development
DEBUG=True

# --- Service Host & Ports ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
INCIDENT_SERVICE_HOST=0.0.0.0
INCIDENT_SERVICE_PORT=8001

# --- Base URLs for Inter-Service Communication ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
INCIDENT_SERVICE_URL=http://localhost:8001

# --- Database Configuration ---
DATABASE_URL=sqlite:///./database/students.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=3

# --- LLM API Configuration ---
# Primary LLM: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Fallback LLM: NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=nvidia

# Optional legacy providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Logging & Metrics ---
LOG_LEVEL=INFO
LOG_FILE_PATH=backend/logs/app.log

# --- Incident Response System ---
DETECTOR_INTERVAL_SECONDS=5
ERROR_RATE_THRESHOLD=0.5
MAX_HYPOTHESES=3

# --- Email & Alerting (SMTP) ---
DEVOPS_EMAIL=devops-engineer@hackqubit.local
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=incident-system@hackqubit.local
EMAIL_MOCK_MODE=true

